# ==============================================================================
# WealthTrackPro Backend Environment Variables (.env.example)
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL
# ==============================================================================

# Application & Environment
PROJECT_NAME="Wealth Management API"
ENVIRONMENT="development"              # Set to "production" on Render
SEED_DEMO_USER=true                   # Set to false in production to disable demo user seeding

# Security & Authentication
# Generate in terminal: openssl rand -hex 32
SECRET_KEY="YOUR_SUPER_SECRET_KEY_CHANGE_THIS_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Render PostgreSQL internal/external URL)
# Note: Render often supplies postgres://... — the code automatically normalizes to postgresql://...
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wealth_db"

# Google OAuth 2.0 Credentials
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth Redirect & Frontend URLs (Must match Google Cloud Console authorized URIs)
# On Render: https://<backend-service>.onrender.com/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# On Render: https://<frontend-site>.onrender.com (used for CORS and OAuth return)
FRONTEND_URL="http://localhost:5173"
