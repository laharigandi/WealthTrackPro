# ==============================================================================
# WealthTrackPro Frontend Environment Variables (.env.example)
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Backend API Base URL
# Local development: http://127.0.0.1:8000/api/v1
# Render Production Static Site: https://<backend-service>.onrender.com/api/v1
# CRITICAL: Always include the /api/v1 prefix path
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Optional: Google OAuth Web Client ID (only if client-side Google One-Tap/GIS is enabled)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
